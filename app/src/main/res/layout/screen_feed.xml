<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volver" />
<TextView android:id="@+id/feed_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" />
<ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<EditText android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Título o nombre del producto" android:inputType="textCapSentences" />
<EditText android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Escribe aquí" android:inputType="textMultiLine|textCapSentences" android:maxLines="3" />
<EditText android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Precio en CLP" android:inputType="number" />
<Button android:id="@+id/send" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enviar" />
<Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reintentar conexión" />
</LinearLayout>
